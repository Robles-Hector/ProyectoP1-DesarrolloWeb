@model SakilaRentalApp.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-primary text-white text-center py-3">
                <i class="bi bi-person-circle fs-1"></i>
                <h4 class="mb-0 mt-2">Iniciar Sesión</h4>
                <p class="small mb-0 opacity-75">Sistema de Renta de Películas Sakila</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold">
                            <i class="bi bi-person me-1"></i> Usuario
                        </label>
                        <input asp-for="Username" class="form-control form-control-lg" placeholder="Ej: admin o mary.smith" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">
                            <i class="bi bi-key me-1"></i> Contraseña
                        </label>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe">
                            Mantener sesión activa
                        </label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Ingresar al Sistema
                        </button>
                    </div>

                    <div class="text-center">
                        <span class="text-muted small">¿No tienes cuenta?</span>
                        <a asp-action="Register" class="text-decoration-none fw-semibold">Regístrate como nuevo cliente</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Panel Informativo de Credenciales y Reto de Seguridad -->
    <div class="col-md-5 mt-4 mt-md-0">
        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body">
                <h5 class="card-title fw-bold text-dark">
                    <i class="bi bi-info-circle-fill text-info me-2"></i> Usuarios de Prueba Preconfigurados
                </h5>
                <p class="small text-muted">
                    Utilice cualquiera de las siguientes cuentas para explorar los dos perfiles del sistema:
                </p>
                <div class="list-group list-group-flush small">
                    <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-danger me-2">Administrador</span>
                            <strong>admin</strong>
                        </div>
                        <code>Admin123!</code>
                    </div>
                    <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-success me-2">Cliente 1</span>
                            <strong>mary.smith</strong>
                        </div>
                        <code>Cliente123!</code>
                    </div>
                    <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-success me-2">Cliente 2</span>
                            <strong>patricia.johnson</strong>
                        </div>
                        <code>Cliente123!</code>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-primary bg-opacity-10">
            <div class="card-body">
                <h6 class="fw-bold text-primary">
                    <i class="bi bi-shield-check me-2"></i> Reto Técnico 1: Contraseñas Protegidas
                </h6>
                <p class="small text-muted mb-0">
                    Las contraseñas se almacenan mediante el algoritmo criptográfico <strong>PBKDF2 con HMAC-SHA256 y Salt aleatoria de 128 bits</strong> con 100,000 iteraciones. En la base de datos nunca se guarda el texto plano, cumpliendo las buenas prácticas de seguridad.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
