@model SakilaRentalApp.Models.ViewModels.FilmFormViewModel

@{
    ViewData["Title"] = "Crear Película";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-plus-circle me-2"></i> Crear Nueva Película
                </h4>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Crear" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" placeholder="Ej: MATRIX RELOADED" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ReleaseYear" class="form-label fw-semibold"></label>
                            <input asp-for="ReleaseYear" class="form-control" placeholder="Ej: 2003" />
                            <span asp-validation-for="ReleaseYear" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Sinopsis o argumento de la película..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="LanguageId" class="form-label fw-semibold"></label>
                            <select asp-for="LanguageId" class="form-select" asp-items="Model.Idiomas"></select>
                            <span asp-validation-for="LanguageId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Rating" class="form-label fw-semibold"></label>
                            <select asp-for="Rating" class="form-select" asp-items="Model.Ratings"></select>
                            <span asp-validation-for="Rating" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Length" class="form-label fw-semibold"></label>
                            <input asp-for="Length" class="form-control" placeholder="Minutos (ej. 120)" />
                            <span asp-validation-for="Length" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="RentalRate" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="RentalRate" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="RentalRate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="RentalDuration" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="RentalDuration" class="form-control" type="number" />
                                <span class="input-group-text">días</span>
                            </div>
                            <span asp-validation-for="RentalDuration" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ReplacementCost" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ReplacementCost" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="ReplacementCost" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SpecialFeatures" class="form-label fw-semibold"></label>
                        <input asp-for="SpecialFeatures" class="form-control" placeholder="Ej: Trailers,Commentaries,Deleted Scenes" />
                        <span asp-validation-for="SpecialFeatures" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info small mb-4">
                        <i class="bi bi-info-circle-fill me-1"></i> Al guardar la película se crearán automáticamente <strong>2 copias iniciales en inventario</strong> (Tienda 1 y Tienda 2) para que esté disponible de inmediato para el alquiler.
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Guardar Película
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
