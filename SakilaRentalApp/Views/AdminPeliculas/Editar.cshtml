@model SakilaRentalApp.Models.ViewModels.FilmFormViewModel

@{
    ViewData["Title"] = "Editar Película";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-pencil-square me-2 text-warning"></i> Editar Película: @Model.Title
                </h4>
                <a asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Editar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FilmId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Title" class="form-label fw-semibold"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ReleaseYear" class="form-label fw-semibold"></label>
                            <input asp-for="ReleaseYear" class="form-control" />
                            <span asp-validation-for="ReleaseYear" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="LanguageId" class="form-label fw-semibold"></label>
                            <select asp-for="LanguageId" class="form-select" asp-items="Model.Idiomas"></select>
                            <span asp-validation-for="LanguageId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Rating" class="form-label fw-semibold"></label>
                            <select asp-for="Rating" class="form-select" asp-items="Model.Ratings"></select>
                            <span asp-validation-for="Rating" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Length" class="form-label fw-semibold"></label>
                            <input asp-for="Length" class="form-control" />
                            <span asp-validation-for="Length" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="RentalRate" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="RentalRate" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="RentalRate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="RentalDuration" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="RentalDuration" class="form-control" type="number" />
                                <span class="input-group-text">días</span>
                            </div>
                            <span asp-validation-for="RentalDuration" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ReplacementCost" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ReplacementCost" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="ReplacementCost" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SpecialFeatures" class="form-label fw-semibold"></label>
                        <input asp-for="SpecialFeatures" class="form-control" />
                        <span asp-validation-for="SpecialFeatures" class="text-danger small"></span>
                    </div>

                    <!-- Reto 2: Opción de Eliminación Lógica directa en el formulario -->
                    <div class="card p-3 mb-4 bg-light border-0">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsDeleted" id="swDeleted">
                            <label class="form-check-label fw-bold text-danger" for="swDeleted">
                                <i class="bi bi-trash me-1"></i> Desactivar esta película (Eliminación Lógica)
                            </label>
                            <p class="small text-muted mb-0">
                                Al marcar esta opción, la película no se borrará físicamente de SQL Server pero dejará de estar visible en el catálogo de los clientes.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Actualizar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
