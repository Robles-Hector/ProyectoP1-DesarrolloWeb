@model SakilaRentalApp.Models.ViewModels.FilmCatalogViewModel

@{
    ViewData["Title"] = "Gestión de Películas (Admin)";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-film text-danger me-2"></i> Gestión Administrativa de Películas
        </h2>
        <p class="text-muted small mb-0">Módulo CRUD y administración de inventario físico y eliminación lógica.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nueva Película
        </a>
    </div>
</div>

<!-- Filtros de Búsqueda y Eliminación Lógica -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar por título..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="rating" class="form-select" asp-items="Model.Ratings" asp-for="Rating">
                </select>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch pt-2">
                    <input class="form-check-input" type="checkbox" name="mostrarEliminadas" value="true" id="chkEliminadas" @(Model.MostrarEliminadas == true ? "checked" : "") onchange="this.form.submit()">
                    <label class="form-check-label small fw-semibold" for="chkEliminadas">
                        Mostrar películas eliminadas lógicamente
                    </label>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla CRUD -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Clasif.</th>
                        <th>Idioma</th>
                        <th>Tarifa</th>
                        <th>Duración</th>
                        <th>Inventario</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Peliculas.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No se encontraron películas con los criterios indicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var film in Model.Peliculas)
                        {
                            <tr class="@(film.IsDeleted ? "table-danger bg-opacity-25" : "")">
                                <td class="fw-bold">@film.FilmId</td>
                                <td>
                                    <strong class="text-dark">@film.Title</strong>
                                    <span class="d-block text-muted small">Año: @(film.ReleaseYear ?? "2006")</span>
                                </td>
                                <td><span class="badge bg-secondary">@film.Rating</span></td>
                                <td>@film.LanguageName</td>
                                <td class="text-success fw-bold">$@film.RentalRate</td>
                                <td>@film.RentalDuration días</td>
                                <td>
                                    <span class="badge @(film.TieneDisponibilidad ? "bg-success" : "bg-warning text-dark")">
                                        @film.CopiasDisponibles / @film.TotalCopias disponibles
                                    </span>
                                </td>
                                <td>
                                    @if (film.IsDeleted)
                                    {
                                        <span class="badge bg-danger" title="Eliminado lógicamente: no visible para clientes">
                                            <i class="bi bi-trash-fill me-1"></i> Inactiva
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> Activa
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Editar" asp-route-id="@film.FilmId" class="btn btn-outline-primary" title="Editar película">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Inventario" asp-route-id="@film.FilmId" class="btn btn-outline-info" title="Gestionar inventario de copias">
                                            <i class="bi bi-boxes"></i>
                                        </a>
                                        <a asp-controller="Peliculas" asp-action="Detalle" asp-route-id="@film.FilmId" class="btn btn-outline-secondary" title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        
                                        <!-- Reto 2: Eliminación Lógica con Confirmación -->
                                        <form asp-action="ToggleDelete" asp-route-id="@film.FilmId" asp-route-returnUrl="@Context.Request.Path" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (film.IsDeleted)
                                            {
                                                <button type="submit" class="btn btn-outline-success" title="Reactivar película" onclick="return confirm('¿Desea reactivar esta película para que vuelva a estar disponible en el catálogo?');">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-danger" title="Eliminación lógica" onclick="return confirm('¿Está seguro de eliminar lógicamente esta película? Dejará de aparecer en el catálogo para los clientes pero se preservará su historial.');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación -->
@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación admin" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" 
                   asp-route-pagina="@(Model.PaginaActual - 1)"
                   asp-route-buscar="@Model.Buscar"
                   asp-route-rating="@Model.Rating"
                   asp-route-mostrarEliminadas="@Model.MostrarEliminadas">
                    <i class="bi bi-chevron-left"></i> Anterior
                </a>
            </li>

            @{
                int startPage = Math.Max(1, Model.PaginaActual - 2);
                int endPage = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pagina="@i"
                       asp-route-buscar="@Model.Buscar"
                       asp-route-rating="@Model.Rating"
                       asp-route-mostrarEliminadas="@Model.MostrarEliminadas">@i</a>
                </li>
            }

            <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pagina="@(Model.PaginaActual + 1)"
                   asp-route-buscar="@Model.Buscar"
                   asp-route-rating="@Model.Rating"
                   asp-route-mostrarEliminadas="@Model.MostrarEliminadas">
                    Siguiente <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
