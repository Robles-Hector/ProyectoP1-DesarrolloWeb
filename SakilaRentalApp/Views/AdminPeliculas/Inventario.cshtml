@model List<SakilaRentalApp.Models.InventoryItem>

@{
    var film = ViewBag.Film as SakilaRentalApp.Models.Film;
    ViewData["Title"] = "Gestión de Inventario: " + (film?.Title ?? "");
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver a Películas
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-secondary mb-2">Clasificación: @(film?.Rating ?? "PG")</span>
                <h3 class="fw-bold text-dark mb-1">
                    <i class="bi bi-boxes text-info me-2"></i> Inventario de Copias: @(film?.Title ?? "")
                </h3>
                <p class="text-muted small mb-0">
                    Administre las copias físicas disponibles para los clientes en las sucursales de Sakila.
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="card bg-light border-0 p-3 d-inline-block text-start">
                    <div class="small text-muted">Total de Copias Registradas:</div>
                    <div class="fs-4 fw-bold text-primary">@Model.Count copias</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Tabla de Copias Existentes -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-list-check me-2"></i> Listado de Copias Físicas Registradas
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th># Inventario</th>
                                <th>Tienda</th>
                                <th>Estado</th>
                                <th>Cliente Actual</th>
                                <th>Fecha de Renta</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        No existen copias registradas para esta película en la tabla inventory. Agregue una nueva copia con el formulario lateral.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-dark fs-6">#@item.InventoryId</span></td>
                                        <td>Tienda @item.StoreId</td>
                                        <td>
                                            @if (item.EstaAlquilada)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-clock-history me-1"></i> Alquilada
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Disponible
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @(item.CurrentCustomerName ?? "—")
                                        </td>
                                        <td class="small text-muted">
                                            @(item.CurrentRentalDate.HasValue ? item.CurrentRentalDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulario para Agregar Copia -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-plus-square me-2"></i> Añadir Copia a Inventario
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AgregarCopia" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="filmId" value="@(film?.FilmId ?? 0)" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Película</label>
                        <input type="text" class="form-control" value="@(film?.Title ?? "")" readonly />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Seleccionar Tienda / Sucursal</label>
                        <select name="storeId" class="form-select">
                            <option value="1">Tienda 1 (Sucursal Principal)</option>
                            <option value="2">Tienda 2 (Sucursal Secundaria)</option>
                        </select>
                        <small class="text-muted">La copia se asignará a la tienda seleccionada con fecha actual.</small>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary fw-semibold shadow-sm">
                            <i class="bi bi-plus-circle me-1"></i> Registrar Nueva Copia
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
