@model List<SakilaRentalApp.Models.Rental>

@{
    ViewData["Title"] = "Control Global de Alquileres";
    string? buscarCliente = ViewBag.BuscarCliente as string;
    bool soloPendientes = (bool)(ViewBag.SoloPendientes ?? false);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-card-checklist text-warning me-2"></i> Control Global de Alquileres (Admin)
        </h2>
        <p class="text-muted small mb-0">Auditoría completa de las transacciones de alquiler y devolución de Sakila.</p>
    </div>
</div>

<!-- Filtros de búsqueda -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="HistorialAdmin" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="buscarCliente" value="@buscarCliente" class="form-control" placeholder="Buscar por cliente o película..." />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check form-switch pt-2">
                    <input class="form-check-input" type="checkbox" name="soloPendientes" value="true" id="chkSoloPendientes" @(soloPendientes ? "checked" : "") onchange="this.form.submit()">
                    <label class="form-check-label small fw-semibold" for="chkSoloPendientes">
                        Mostrar únicamente alquileres sin devolver
                    </label>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-action="HistorialAdmin" class="btn btn-outline-secondary" title="Limpiar">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th># Renta</th>
                        <th>Película</th>
                        <th>Cliente</th>
                        <th>Fecha Alquiler</th>
                        <th>Fecha Devolución</th>
                        <th>Atendido por</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No se encontraron registros de alquileres.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model)
                        {
                            <tr class="@(!r.EstaDevuelto ? "table-warning bg-opacity-25" : "")">
                                <td class="fw-bold">#@r.RentalId</td>
                                <td>
                                    <strong class="text-dark">@r.FilmTitle</strong>
                                    <span class="d-block text-muted small">Copia #@r.InventoryId</span>
                                </td>
                                <td>
                                    <i class="bi bi-person me-1"></i>
                                    <strong>@r.CustomerName</strong>
                                    <span class="d-block text-muted small">ID Cliente: @r.CustomerId</span>
                                </td>
                                <td class="small">@r.RentalDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="small">
                                    @(r.ReturnDate.HasValue ? r.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")
                                </td>
                                <td class="small text-muted">@(r.StaffName ?? "Empleado")</td>
                                <td>
                                    @if (r.EstaDevuelto)
                                    {
                                        <span class="badge bg-success">Devuelto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">En Préstamo</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (!r.EstaDevuelto)
                                    {
                                        <form asp-action="Devolver" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="rentalId" value="@r.RentalId" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-outline-success btn-sm" onclick="return confirm('¿Registrar devolución de esta película en mostrador?');">
                                                <i class="bi bi-box-arrow-in-down me-1"></i> Registrar Devolución
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-check-all text-success"></i> Cerrado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
