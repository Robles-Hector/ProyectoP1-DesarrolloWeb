@model List<SakilaRentalApp.Models.Rental>

@{
    ViewData["Title"] = "Mis Alquileres";
    string? nombreCliente = Context.Session.GetNombreCompleto();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-clock-history text-success me-2"></i> Mis Alquileres de Películas
        </h2>
        <p class="text-muted small mb-0">
            Historial de alquileres para el cliente: <strong>@nombreCliente</strong>.
        </p>
    </div>
    <div>
        <a asp-controller="Peliculas" asp-action="Index" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Alquilar Otra Película
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="bi bi-collection me-2 text-primary"></i> Alquileres Registrados (@Model.Count)
        </h5>
        <div class="small text-muted">
            <span class="badge bg-warning text-dark me-2">
                @Model.Count(r => !r.EstaDevuelto) pendientes
            </span>
            <span class="badge bg-success">
                @Model.Count(r => r.EstaDevuelto) devueltos
            </span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th># Renta</th>
                        <th>Película</th>
                        <th>Fecha de Alquiler</th>
                        <th>Tarifa</th>
                        <th>Fecha de Devolución</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-film display-4 text-muted mb-3 d-block"></i>
                                <h6 class="text-muted">Aún no has realizado ningún alquiler de películas.</h6>
                                <p class="small text-muted mb-3">Explora nuestro catálogo para seleccionar tu primera película.</p>
                                <a asp-controller="Peliculas" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                    Ir al Catálogo de Películas
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model)
                        {
                            <tr class="@(!r.EstaDevuelto ? "table-warning bg-opacity-25" : "")">
                                <td class="fw-bold">#@r.RentalId</td>
                                <td>
                                    <strong class="text-dark">@r.FilmTitle</strong>
                                    <span class="d-block text-muted small">Copia en Inventario #@r.InventoryId</span>
                                </td>
                                <td>
                                    <i class="bi bi-calendar-event me-1 text-muted"></i>
                                    @r.RentalDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-success fw-bold">$@r.RentalRate</td>
                                <td>
                                    @if (r.EstaDevuelto)
                                    {
                                        <span class="text-muted small">
                                            <i class="bi bi-calendar-check me-1 text-success"></i>
                                            @r.ReturnDate!.Value.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split me-1"></i> En tu poder
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (r.EstaDevuelto)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> Devuelto
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i> Pendiente
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (!r.EstaDevuelto)
                                    {
                                        <!-- Regla de Negocio: Devolución sin eliminar el registro histórico -->
                                        <form asp-action="Devolver" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="rentalId" value="@r.RentalId" />
                                            <button type="submit" class="btn btn-success btn-sm shadow-sm" onclick="return confirm('¿Desea registrar la devolución de la película \'@r.FilmTitle\'?');">
                                                <i class="bi bi-arrow-return-left me-1"></i> Devolver Película
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" disabled>
                                            <i class="bi bi-check2"></i> Devuelto
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
