@model List<SakilaRentalApp.Models.ViewModels.PeliculasMasAlquiladasViewModel>

@{
    ViewData["Title"] = "Reporte - Películas Más Alquiladas";
    int top = ViewBag.Top ?? 10;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-trophy-fill text-warning me-2"></i> Reporte: Películas Más Alquiladas
        </h2>
        <p class="text-muted small mb-0">
            Top de películas con mayor demanda histórica en Sakila (film &rarr; inventory &rarr; rental).
        </p>
    </div>
    <div>
        <div class="btn-group" role="group">
            <a asp-action="PeliculasMasAlquiladas" asp-route-top="10" class="btn @(top == 10 ? "btn-primary" : "btn-outline-primary") btn-sm">Top 10</a>
            <a asp-action="PeliculasMasAlquiladas" asp-route-top="20" class="btn @(top == 20 ? "btn-primary" : "btn-outline-primary") btn-sm">Top 20</a>
            <a asp-action="PeliculasMasAlquiladas" asp-route-top="50" class="btn @(top == 50 ? "btn-primary" : "btn-outline-primary") btn-sm">Top 50</a>
        </div>
    </div>
</div>

<!-- Cuadro Explicativo de la Consulta ADO.NET -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-light">
    <div class="card-body p-3">
        <h6 class="fw-bold text-dark mb-1">
            <i class="bi bi-code-slash text-primary me-2"></i> Consulta SQL ADO.NET Ejecutada
        </h6>
        <p class="small text-muted mb-2">
            La información se obtiene directamente de SQL Server mediante <code>Microsoft.Data.SqlClient</code> aplicando 
            <strong>INNER JOIN</strong>, <strong>COUNT</strong>, <strong>GROUP BY</strong>, <strong>ORDER BY</strong> y <strong>TOP (@top)</strong>:
        </p>
        <pre class="bg-dark text-warning p-3 rounded-2 small mb-0 font-monospace">
SELECT TOP (@@Top)
    f.film_id,
    f.title AS pelicula,
    COUNT(r.rental_id) AS cantidad_alquileres,
    f.rating,
    f.release_year,
    f.rental_rate,
    (SELECT COUNT(*) FROM inventory i WHERE i.film_id = f.film_id) AS copias_inventario,
    (SELECT COUNT(*) FROM inventory i WHERE i.film_id = f.film_id AND i.inventory_id NOT IN (
        SELECT r2.inventory_id FROM rental r2 WHERE r2.return_date IS NULL
    )) AS copias_disponibles
FROM film f
INNER JOIN inventory i ON f.film_id = i.film_id
INNER JOIN rental r ON i.inventory_id = r.inventory_id
GROUP BY f.film_id, f.title, f.rating, f.release_year, f.rental_rate
ORDER BY cantidad_alquileres DESC;</pre>
    </div>
</div>

<!-- Tabla de Resultados del Reporte -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width: 70px;">Puesto</th>
                        <th>Película</th>
                        <th class="text-center">Clasificación</th>
                        <th class="text-center">Año</th>
                        <th class="text-center">Tarifa</th>
                        <th class="text-center">Copias en Inventario</th>
                        <th class="text-center">Disponibles Hoy</th>
                        <th class="text-center fw-bold bg-primary text-white">Cantidad de Alquileres</th>
                        <th class="text-end pe-4">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int puesto = 1;
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">
                                @if (puesto == 1)
                                {
                                    <span class="badge rounded-pill bg-warning text-dark fs-6"><i class="bi bi-award-fill"></i> 1</span>
                                }
                                else if (puesto == 2)
                                {
                                    <span class="badge rounded-pill bg-secondary fs-6">2</span>
                                }
                                else if (puesto == 3)
                                {
                                    <span class="badge rounded-pill bg-danger bg-opacity-75 fs-6">3</span>
                                }
                                else
                                {
                                    <span class="text-muted fw-semibold">@puesto</span>
                                }
                            </td>
                            <td>
                                <strong class="text-dark fs-6">@p.Titulo</strong>
                                <span class="d-block text-muted small">Film ID #@p.FilmId</span>
                            </td>
                            <td class="text-center"><span class="badge bg-secondary">@p.Rating</span></td>
                            <td class="text-center text-muted small">@(p.ReleaseYear ?? "2006")</td>
                            <td class="text-center text-success fw-bold">$@p.RentalRate</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@p.CopiasInventario copias</span>
                            </td>
                            <td class="text-center">
                                @if (p.CopiasDisponibles > 0)
                                {
                                    <span class="badge bg-success">@p.CopiasDisponibles libres</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Agotada</span>
                                }
                            </td>
                            <td class="text-center fw-bold fs-5 text-primary">
                                @p.CantidadAlquileres
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Peliculas" asp-action="Detalle" asp-route-id="@p.FilmId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i> Ver Detalle
                                </a>
                            </td>
                        </tr>
                        puesto++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
