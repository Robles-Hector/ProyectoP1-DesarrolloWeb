@{
    bool estaAutenticado = Context.Session.EstaAutenticado();
    string? username = Context.Session.GetUsername();
    string? rol = Context.Session.GetRol();
    string? nombreCompleto = Context.Session.GetNombreCompleto();
    bool esAdmin = Context.Session.EsAdmin();
    bool esCliente = Context.Session.EsCliente();
}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm border-bottom border-primary">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold d-flex align-items-center text-primary" asp-controller="Home" asp-action="Index">
            <i class="bi bi-film me-2 fs-3 text-warning"></i>
            <span>Sakila<span class="text-white">Rental</span></span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-dismiss="collapse" data-bs-target="#navbarMain" 
                aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-1"></i> Inicio
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white-50" asp-controller="Peliculas" asp-action="Index">
                        <i class="bi bi-collection-play me-1"></i> Catálogo
                    </a>
                </li>

                @if (esCliente)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white-50" asp-controller="Alquileres" asp-action="MisAlquileres">
                            <i class="bi bi-clock-history me-1"></i> Mis Alquileres
                        </a>
                    </li>
                }

                @if (esAdmin)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-warning fw-semibold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-shield-lock me-1"></i> Administración
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown">
                            <li>
                                <a class="dropdown-item" asp-controller="AdminPeliculas" asp-action="Index">
                                    <i class="bi bi-film me-2"></i> Gestión de Películas (CRUD)
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="AdminPeliculas" asp-action="Crear">
                                    <i class="bi bi-plus-circle me-2"></i> Nueva Película
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Alquileres" asp-action="HistorialAdmin">
                                    <i class="bi bi-card-checklist me-2"></i> Control de Alquileres
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                <li class="nav-item">
                    <a class="nav-link text-white-50" asp-controller="Reportes" asp-action="PeliculasMasAlquiladas">
                        <i class="bi bi-bar-chart-line me-1"></i> Reportes
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto align-items-center">
                @if (estaAutenticado)
                {
                    <li class="nav-item me-3 text-light d-flex align-items-center">
                        <span class="me-2 text-white-50 small">Conectado como:</span>
                        <span class="fw-bold text-white me-2">@nombreCompleto</span>
                        @if (esAdmin)
                        {
                            <span class="badge bg-danger text-uppercase px-2 py-1"><i class="bi bi-shield-fill-check me-1"></i>Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-success text-uppercase px-2 py-1"><i class="bi bi-person-fill me-1"></i>Cliente</span>
                        }
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i> Salir
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus me-1"></i> Registrarse
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
